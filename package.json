{
  "name": "integration-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "dev": "node scripts/serve.ts dev",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node scripts/serve.ts start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node scripts/db.ts migrate",
    "db:seed": "node scripts/db.ts seed",
    "db:check": "node scripts/db.ts check",
    "db:rebuild-fts": "node scripts/db.ts rebuild-fts",
    "db:backup": "node scripts/db.ts backup",
    "db:restore": "node scripts/db.ts restore",
    "db:benchmark": "node scripts/db.ts benchmark",
    "db:generate": "drizzle-kit generate",
    "test:http": "node --test tests/http/*.test.mjs",
    "demo": "node scripts/demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "5.3.0",
    "@next/env": "16.4.5",
    "@tanstack/query-async-storage-persister": "5.107.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-persist-client": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "eslint": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    }
  }
}
