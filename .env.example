# Скопируйте в .env.local.
HOST=127.0.0.1
PORT=3000
# DATABASE_PATH должен быть абсолютным и находиться вне public/.next/out.
# По умолчанию: <корень проекта>/data/events.db; контейнер: /app/data/events.db.
# DATABASE_PATH=/absolute/path/to/data/events.db

# SSE: положительные целые числа; значения ниже — defaults.
SSE_MAX_CONNECTIONS=32
SSE_POLL_MS=500
SSE_HEARTBEAT_MS=15000
SSE_BATCH_SIZE=100
SSE_MAX_BACKLOG=10000
