      "checkConstraints": {
        "events_seq_safe": {
          "name": "events_seq_safe",
          "value": "\"events\".\"seq\" BETWEEN 1 AND 9007199254740991"
        },
        "events_id_length": {
          "name": "events_id_length",
          "value": "length(\"events\".\"id\") BETWEEN 1 AND 100 AND instr(\"events\".\"id\", char(0)) = 0"
        },
        "events_source_length": {
          "name": "events_source_length",
          "value": "length(\"events\".\"source\") BETWEEN 1 AND 100 AND instr(\"events\".\"source\", char(0)) = 0"
        },
        "events_type_length": {
          "name": "events_type_length",
          "value": "length(\"events\".\"type\") BETWEEN 1 AND 150 AND instr(\"events\".\"type\", char(0)) = 0"
        },
        "events_message_length": {
          "name": "events_message_length",
          "value": "length(\"events\".\"message\") BETWEEN 1 AND 2000 AND instr(\"events\".\"message\", char(0)) = 0"
        },
        "events_status": {
          "name": "events_status",
          "value": "\"events\".\"status\" IN ('success', 'error')"
        },
        "events_created_time": {
          "name": "events_created_time",
          "value": "\"events\".\"created_at_ms\" BETWEEN -62135596800000 AND 253402300799999"
        },
        "events_received_time": {
          "name": "events_received_time",
          "value": "\"events\".\"received_at_ms\" BETWEEN -62135596800000 AND 253402300799999"
        },
        "events_error_code": {
          "name": "events_error_code",
          "value": "\"events\".\"error_code\" IS NULL OR (\"events\".\"status\" = 'error' AND length(\"events\".\"error_code\") BETWEEN 1 AND 100 AND instr(\"events\".\"error_code\", char(0)) = 0)"
        },
        "events_payload": {
          "name": "events_payload",
          "value": "\"events\".\"payload_json\" IS NULL OR (json_valid(\"events\".\"payload_json\") AND json_type(\"events\".\"payload_json\") = 'object' AND length(CAST(\"events\".\"payload_json\" AS BLOB)) <= 16384)"
        },
        "events_hash": {
          "name": "events_hash",
          "value": "length(\"events\".\"canonical_hash\") = 64 AND \"events\".\"canonical_hash\" NOT GLOB '*[^0-9a-f]*'"
        }
      }
