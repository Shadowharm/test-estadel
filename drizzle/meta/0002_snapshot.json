          "name": "events_status",
          "value": "\"events\".\"status\" IN ('success', 'error')"
        },
        "events_created_time": {
          "name": "events_created_time",
          "value": "\"events\".\"created_at_ms\" BETWEEN -62135596800000 AND 253402300799999"
