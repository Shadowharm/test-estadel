        "events_received_time": {
          "name": "events_received_time",
          "value": "\"events\".\"received_at_ms\" BETWEEN -62135596800000 AND 253402300799999"
        },
        "events_error_code": {
          "name": "events_error_code",
          "value": "\"events\".\"error_code\" IS NULL OR (\"events\".\"status\" = 'error' AND length(\"events\".\"error_code\") BETWEEN 1 AND 100 AND instr(\"events\".\"error_code\", char(0)) = 0)"
        },
        "events_payload": {
          "name": "events_payload",
          "value": "\"events\".\"payload_json\" IS NULL OR (json_valid(\"events\".\"payload_json\") AND json_type(\"events\".\"payload_json\") = 'object' AND length(CAST(\"events\".\"payload_json\" AS BLOB)) <= 16384)"
        },
        "events_hash": {
          "name": "events_hash",
          "value": "length(\"events\".\"canonical_hash\") = 64 AND \"events\".\"canonical_hash\" NOT GLOB '*[^0-9a-f]*'"
